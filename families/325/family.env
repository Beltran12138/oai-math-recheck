# openai/math result family 325 -- "the complete Crouzeix inequality"
# Sourced by ../../recheck.sh and ../../audit.sh.  Paths are relative to the
# `lean/` directory of openai/math, except COPIED_INTO / NEG_FILE which are
# files of ours copied into the generated project.

FAMILY_DIR=OAI/Analysis/DirectCrouzeix
CHALLENGE=ComparatorChallenges/DirectCrouzeix.lean
MAIN_IMPORT=OAI.Analysis.DirectCrouzeix.Main

# The two headline theorems.  Family 325 carries five comparator files; the
# other three are support lemmas.  lean/docs/325.md is what says so -- opening
# a comparator file at random is how you end up auditing the wrong theorem.
THEOREMS="OAI.DirectCrouzeix.complete_crouzeix OAI.DirectCrouzeix.uniform_sharpness"

# Our own files, built in gate C.
AUDIT_TARGETS="Verify Scalar"

# Gate D: Verify.lean re-declares these five definitions so that a defeq check
# is possible.  They must be verbatim the challenge's, or gate C proves nothing.
COPIED_INTO=Verify.lean
COPIED_DEFS="numericalRange polynomialValue tensorEvaluation rangeMaximum UniversalBound"

# Gate E: 2 is the whole claim, so weaken it to 1 and require a rejection.
NEG_FILE=Scalar.lean
NEG_SED='s/≤ 2 \* sSup/≤ 1 * sSup/'
